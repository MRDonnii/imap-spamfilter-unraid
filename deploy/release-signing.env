# 2.12 (#16): release signing (read by deploy/update-runner.sh and
# deploy/sign-release.sh; plain KEY=VALUE lines).
# Identity and namespace of ssh-keygen -Y sign/verify.
RELEASE_SIGN_ID=spamfilter-release
RELEASE_SIGN_NAMESPACE=spamfilter-release
# Releases from this version on MUST carry a valid .sha256.sig when
# deploy/release-signers holds a key; older ones may be unsigned.
RELEASE_SIGNED_SINCE=2.12.1
