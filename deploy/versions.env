# Single source of truth for what the deploy scripts run.
# Sourced by deploy/lib.sh (plain KEY=VALUE lines, no spaces, no logic).
# Infra images are pinned by digest; the filter image is built locally from
# filter/Dockerfile.unraid, whose FROM must equal FILTER_BASE_IMAGE.
VERSION=2.14.2
# 2.4: production is ONE container 'spamfilter' from deploy/aio/Dockerfile
# (deploy/aio/build.sh builds AIO_IMAGE). FILTER_IMAGE is the filter-only
# image of the 4-container layout (rollback / recreate-filter.sh only).
AIO_IMAGE=imap-spamfilter-unraid:2.14.2
FILTER_IMAGE=imap-spamfilter-unraid:2.14.2-filter
FILTER_BASE_IMAGE=ghcr.io/marcelverdult/imap-spamfilter@sha256:11b10295f03a7eb503c7cf40a370334f33a902ca3470b28ce1a344a2bed85f7c
REDIS_IMAGE=redis@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0
RSPAMD_IMAGE=rspamd/rspamd@sha256:33526f94cfbb5ab5485805ad9d6eddb6a52aca6529aad0ce99b67b01c2e756de
UNBOUND_IMAGE=mvance/unbound@sha256:76906da36d1806f3387338f15dcf8b357c51ce6897fb6450d6ce010460927e90

# AIO image ingredients (deploy/aio/Dockerfile). The rspamd base is the SAME
# digest as RSPAMD_IMAGE (rspamd stays byte-identical); the filter stage uses
# FILTER_BASE_IMAGE. Redis 8.10.3 binaries are copied from the official
# Debian-based image, pinned by its multi-arch index digest (resolved from
# Docker Hub on 2026-11-21; linux/amd64 is 8.10.3). 2.12 (#7): RSPAMD_IMAGE
# is the current multi-arch index of rspamd/rspamd:4.2.2 (same rspamd,
# rebuilt Debian base; resolved 2026-11-21); FILTER_BASE_IMAGE and
# UNBOUND_IMAGE were checked the same day and are still the newest builds.
# Re-check monthly (Dependabot opens a reminder PR for the GitHub Actions;
# the image pins are resolved by hand with the registry digest). Every build - Unraid,
# CI and the release - uses exactly this image; the release refuses to
# publish without it. (Empty = resolve the tag at build time: never for a
# release.)
REDIS_AIO_TAG=8.10.3-trixie
REDIS_AIO_DIGEST=sha256:1f88291b4c57bdf249f02eb085a8669889b2d2954e91d4de5118a5da6b78dd53
# Versions the AIO build asserts (deploy/aio/build-check.sh).
AIO_RSPAMD_VERSION=4.2.2
AIO_REDIS_VERSION=8.10.3
AIO_UNBOUND_SERIES=1.26
AIO_PYTHON_SERIES=3.14
# 2.12 (#7): the lowest ClamAV the build accepts (Debian trixie's maintained
# package, security fixes via trixie-updates; 1.4 is ClamAV's LTS series).
AIO_CLAMAV_MIN=1.4.6

# rspamd fuzzy_check against the public rspamd.com storage (read-only).
# 0 = install rspamd/local.d/fuzzy_check.conf (disabled)
# 1 = install rspamd/local.d/fuzzy_check.conf.readonly as fuzzy_check.conf;
#     after rspamd restarts, `rspamadm fuzzy_ping` must get replies (UDP
#     11335 egress), otherwise the deploy falls back to the disabled file.
# Owner approved read-only fuzzy on 2026-10-20 (SPEC section 9).
# Apply a change with: deploy/recreate-infra.sh rspamd
ENABLE_FUZZY=1

# Runtime identity of the filter container (owner of state/ and config/).
FILTER_UID=10099
FILTER_GID=10099

# LAN binding of the WebUI (host side of -p).
# The LAN address the WebUI port is bound to. Set it for your server in
# operations/site.env (WEBUI_BIND=192.168.1.10); empty = the host's own LAN
# address (the source address of its default route, see deploy/lib.sh).
WEBUI_BIND="${WEBUI_BIND:-}"
WEBUI_PORT=18080

# Reverse proxy / Cloudflare Tunnel in front of the WebUI (2.1).
# Comma-separated IPs/CIDRs (no spaces) of the proxy that connects to the
# filter (e.g. the cloudflared container's address). Only requests from
# these peers may set the client IP / https / host via CF-Connecting-IP,
# X-Forwarded-For, X-Forwarded-Proto and X-Forwarded-Host. Empty = trust
# nobody (LAN only). Indstillinger -> "Adgang udefra" shows the address a
# proxied request comes from. Apply with: deploy/recreate-filter.sh
TRUSTED_PROXIES=
